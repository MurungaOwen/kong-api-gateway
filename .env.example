# Copy to .env to override. Compose passes these to every service that needs them.

# Signs/verifies the admin JWTs Kong checks on /billing/*. Keep it long and secret.
JWT_SECRET=change-me-to-a-long-random-string

# Optional login for the dashboard (HTTP Basic: any username, this password).
# Leave empty on localhost; set it before exposing port 3000 anywhere else.
DASHBOARD_PASSWORD=
